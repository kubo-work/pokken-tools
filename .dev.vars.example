# wrangler dev / next dev で読み込まれるローカル用シークレット。
# このファイルを `.dev.vars` にコピーして値を埋める。`.dev.vars` は .gitignore 対象。

# `openssl rand -base64 32` などで生成
AUTH_SECRET=

# Google Cloud Console > API & Services > Credentials で OAuth 2.0 Client ID を作成。
# Redirect URI に http://localhost:3000/api/auth/callback/google を登録する。
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# next-auth v5 がリダイレクト先を組み立てる際に使う。ローカル開発時は明示すると安全。
AUTH_URL=http://localhost:3000

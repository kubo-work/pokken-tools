# wrangler dev / react-router dev で読み込まれるローカル用シークレット。
# このファイルを `.dev.vars` にコピーして値を埋める。`.dev.vars` は .gitignore 対象。

# `openssl rand -base64 32` などで生成。セッション Cookie の署名に使う。
AUTH_SECRET=

# Google Cloud Console > API & Services > Credentials で OAuth 2.0 Client ID を作成。
# 承認済みリダイレクト URI に http://localhost:2015/auth/google/callback を登録する。
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

{
  "name": "pokken",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.2.15",
  "scripts": {
    "dev": "next dev -p 2015",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=scripts/seed-allowlist.local.sql",
    "db:seed:remote": "wrangler d1 execute DB --remote --file=scripts/seed-allowlist.local.sql",
    "db:allowlist:list:local": "bun scripts/allowlist.ts list --local",
    "db:allowlist:list:remote": "bun scripts/allowlist.ts list --remote",
    "db:allowlist:add:local": "bun scripts/allowlist.ts add --local",
    "db:allowlist:add:remote": "bun scripts/allowlist.ts add --remote",
    "kv:seed:local": "bun scripts/seed-kv.ts --local",
    "kv:seed:remote": "bun scripts/seed-kv.ts --remote",
    "kv:migrate:strength:local": "bun scripts/migrations/migrate-kv-strength.ts --local",
    "kv:migrate:strength:remote": "bun scripts/migrations/migrate-kv-strength.ts --remote",
    "kv:migrate:strength:remote:dry": "bun scripts/migrations/migrate-kv-strength.ts --remote --dry-run"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@mantine/core": "9.4.1",
    "@mantine/hooks": "9.4.1",
    "@opennextjs/cloudflare": "1.20.1",
    "@tabler/icons-react": "3.44.0",
    "next": "16.2.9",
    "next-auth": "5.0.0-beta.31",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@locator/runtime": "^0.5.1",
    "@locator/webpack-loader": "^0.5.1",
    "@types/node": "22.10.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "typescript": "6.0.3",
    "wrangler": "4.105.0"
  }
}

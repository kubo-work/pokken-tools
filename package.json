{
  "name": "pokken",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "test": "bun test",
    "start": "wrangler dev",
    "preview": "bun run build && vite preview",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint .",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=scripts/seed-allowlist.local.sql",
    "db:seed:remote": "wrangler d1 execute DB --remote --file=scripts/seed-allowlist.local.sql",
    "db:allowlist:list:local": "bun scripts/allowlist.ts list --local",
    "db:allowlist:list:remote": "bun scripts/allowlist.ts list --remote",
    "db:allowlist:add:local": "bun scripts/allowlist.ts add --local",
    "db:allowlist:add:remote": "bun scripts/allowlist.ts add --remote",
    "kv:seed:local": "bun scripts/seed-kv.ts --local",
    "kv:seed:remote": "bun scripts/seed-kv.ts --remote",
    "kv:migrate:strength:local": "bun scripts/migrations/migrate-kv-strength.ts --local",
    "kv:migrate:strength:remote": "bun scripts/migrations/migrate-kv-strength.ts --remote",
    "kv:migrate:strength:remote:dry": "bun scripts/migrations/migrate-kv-strength.ts --remote --dry-run"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@mantine/core": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@tabler/icons-react": "3.46.0",
    "isbot": "5.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.3.1",
    "remix-auth": "4.2.0",
    "remix-auth-oauth2": "3.4.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "7.29.9",
    "@babel/preset-typescript": "7.29.7",
    "@cloudflare/vite-plugin": "1.54.9",
    "@locator/babel-jsx": "0.5.1",
    "@locator/runtime": "^0.5.1",
    "@react-router/dev": "8.3.1",
    "@types/bun": "^1.4.2",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-babel": "1.7.3",
    "wrangler": "4.131.2"
  }
}
